# Copy to .env. Do not commit .env. None of these values are secrets by themselves,
# but they identify your Google Cloud OAuth clients. Leave them empty to run without sync.

# Web application client ID (required for Google Sign-In on Android and for ID tokens).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS OAuth client ID.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Reversed iOS client ID. Must start with com.googleusercontent.apps.
# Example: com.googleusercontent.apps.1234567890-abcdef
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Android OAuth client ID. The runtime matches the app by package name + SHA-1;
# this value is recorded so the Cloud project stays documented. It is not embedded as a secret.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
